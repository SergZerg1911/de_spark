from pyspark.sql import SparkSession
from pyspark.sql.functions import col, count, sum, to_date

spark = SparkSession.builder \
    .appName("DE_Spark") \
    .getOrCreate()

df = spark.read.csv("web_server_logs.csv", header=True, inferSchema=True)

top_ips = df.groupBy("ip") \
    .agg(count("*").alias("request_count")) \
    .orderBy(col("request_count").desc()) \
    .limit(10)

print("Top 10 active IP addresses:")
top_ips.show(truncate=False)

method_counts = df.groupBy("method") \
    .agg(count("*").alias("method_count"))

print("Request count by HTTP method:")
method_counts.show(truncate=False)

count_404 = df.filter(col("response_code") == 404).count()
print(f"Number of 404 response codes: {count_404}")

df_with_date = df.withColumn("date", to_date(col("timestamp")))

daily_size = df_with_date.groupBy("date") \
    .agg(sum("response_size").alias("total_response_size")) \
    .orderBy("date")

print("Total response size by day:")
daily_size.show(truncate=False)

spark.stop()